<!DOCTYPE html>
<html>
<head>
    <title>PDF Tools</title>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>

    <div style="display:flex;justify-content:space-between;align-items:center;">
    <h1>PDF Merge & Split</h1>

    <a href="#"
       style="
            background:#2563eb;
            color:white;
            padding:10px 15px;
            border-radius:5px;
            text-decoration:none;
            font-size:14px;">
        🛠️ Help Improve UtilitiesDocker
    </a>
    </div>

    <h2>Merge PDF</h2>

    <form action="/merge" method="post" enctype="multipart/form-data">
        <input type="file" name="files" multiple accept=".pdf" required>
        <button type="submit">Merge</button>
    </form>

    <hr>

    <h2>Split PDF</h2>

    <form action="/split" method="post" enctype="multipart/form-data">
        <input type="file" name="file" accept=".pdf" required>
        <input type="number" name="page" placeholder="Page Number" min="1" required>
        <button type="submit">Split</button>
    </form>

</body>
</html>
